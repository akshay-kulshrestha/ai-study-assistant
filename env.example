# Copy this file to .env and adjust as needed.

# ----------------------------------------------------------------- Gemini --
# Required -- get a free key (no credit card needed) at
# https://aistudio.google.com
GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-latest
# Only relevant if Gemini returns a server-side (5xx) error -- how many
# extra attempts per model, and the linear backoff multiplier in seconds
# between them, before falling through to the next model in
# GEMINI_MODEL_FALLBACKS. See ai_service.py.
# SERVER_ERROR_RETRY_ATTEMPTS=2
# SERVER_ERROR_RETRY_BACKOFF=2

# --------------------------------------------------------------------- app -
# PORT=5002
# FLASK_DEBUG=0
# MAX_SOURCE_CHARS=60000
# DB_BUSY_TIMEOUT_MS=5000
